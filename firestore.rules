rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL';
    }

    // Public result lookup is intentionally limited to the two approved student IDs.
    // Only these documents can be read by students; only Admin can create/update/delete results.
    match /results/{studentId} {
      allow get: if studentId in ['10CF01', '10CF02'];
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // No other client-side access unless explicitly added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
