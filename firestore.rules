rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'thitlinn680@gmail.com';
    }

    // Public result lookup is intentionally limited to the two approved student IDs.
    // Only these documents can be read by students; only Admin can create/update/delete results.
    match /results/{studentId} {
      allow get: if studentId in ['10CF01', '10CF02'];
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Practice scores are stored separately from admin-managed official results.
    // These are client-calculated practice scores and should not be treated as tamper-proof.
    match /practiceResults/{studentId} {
      allow get: if studentId in ['10CF01', '10CF02'];
      allow list: if isAdmin();
      allow create, update: if studentId in ['10CF01', '10CF02']
        && request.resource.data.studentId == studentId
        && request.resource.data.examName == 'Grade 10 Chemistry Practice Exam'
        && request.resource.data.subject == 'Grade 10 Chemistry'
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 50
        && request.resource.data.total == 50
        && request.resource.data.percentage is int
        && request.resource.data.percentage == request.resource.data.score * 2
        && request.resource.data.answered is int
        && request.resource.data.answered >= 0
        && request.resource.data.answered <= 50
        && request.resource.data.unanswered == 50 - request.resource.data.answered;
      allow delete: if isAdmin();
    }

    // No other client-side access unless explicitly added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
